# Copy to .env and fill in. `npm run keys` prints fresh values for every secret below.

# Public URL of the app (used in unsubscribe and tracking links). No trailing slash.
# On the server: APP_URL=https://app.yourdomain.com, plus the two lines below.
APP_URL=http://localhost:3000
# Server only: the domain Caddy gets an HTTPS certificate for, and turning Caddy on.
# APP_DOMAIN=app.yourdomain.com
# COMPOSE_PROFILES=https

# Optional: only this email can create the first (admin) account. Later sign-ups need an admin's approval.
ADMIN_EMAIL=you@yourdomain.com

# Database. Docker Compose builds DATABASE_URL from the three POSTGRES_ values;
# DATABASE_URL below is only used when you run the app without Docker.
POSTGRES_USER=email
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=email_sender
DATABASE_URL=postgres://email:change-this-db-password@127.0.0.1:5432/email_sender

# Ports on this machine (Docker only). Adminer listens on 127.0.0.1 only.
APP_PORT=3000
ADMINER_PORT=8080

# Your user and group id (`id -u`, `id -g`), so migration files Docker writes into drizzle/ belong to you.
UID=1000
GID=1000

# Secrets (keep them out of git; changing ENCRYPTION_KEY makes saved mailbox passwords unreadable)
# AUTH_SECRET signs login and API JWTs; changing it signs everyone out and cancels all API tokens.
AUTH_SECRET=
ENCRYPTION_KEY=
TRACKING_SECRET=
CRON_SECRET=
# Optional shared Bearer key for the API. API JWTs (Settings → API) are the usual way.
API_KEY=

# Push notifications (VAPID). VAPID_SUBJECT is a mailto: or https: contact for the push service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
